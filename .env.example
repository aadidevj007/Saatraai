## Development configuration only. Copy to .env and replace all secrets before deployment.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://saatraai:saatraai_dev@localhost:5432/saatraai
REDIS_URL=redis://localhost:6379/0

## Never use this value in production. Set a long, unique secret there.
JWT_SECRET_KEY=development-only-change-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

LOCAL_STORAGE_PATH=data/uploads
MAX_UPLOAD_BYTES=104857600

## Configure only when the optional GeoChat adapter has been set up.
# GEOCHAT_MODEL_PATH=
# GEOCHAT_MODEL_BASE=
# GEOCHAT_DEVICE=cuda
