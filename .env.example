## Development configuration only. Copy to .env and replace all secrets before deployment.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://saatraai:saatraai_dev@localhost:5432/saatraai
REDIS_URL=redis://localhost:6379/0

## Never use this value in production. Set a long, unique secret there.
JWT_SECRET_KEY=development-only-change-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

LOCAL_STORAGE_PATH=data/uploads
MAX_UPLOAD_BYTES=104857600

## Optional local GeoChat checkpoint directory, relative to apps/api when starting the API.
## Leave unset until the MBZUAI/geochat-7B checkpoint and upstream GeoChat runtime are installed.
# GEOCHAT_MODEL_PATH=./models/geochat-7B
# GEOCHAT_MODEL_BASE=
# GEOCHAT_DEVICE=cuda
# GEOCHAT_MAX_NEW_TOKENS=300
## Optional remote GeoChat GPU worker (runs ml/geochat_worker.py on a GPU host for Render/hosted APIs).
# GEOCHAT_REMOTE_URL=https://your-geochat-gpu-worker.example.com
# GEOCHAT_REMOTE_TOKEN=
# GEOCHAT_REMOTE_TIMEOUT_SECONDS=120
# GeoChat adapter: MBZUAI/geochat-7B / version geochat-7B
# API routes: POST /api/v1/models/geochat/vqa and /grounding

## Cloud OpenRouter API — powers autonomous corpus Information Extraction, location/timestamp
## detection, hypothesis generation, and multimodal vision QA on hosted deployments.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_TIMEOUT_SECONDS=45

## Firebase Admin SDK — server-side verification for Firebase ID tokens.
## Keep the service-account private key on the API server only.
FIREBASE_PROJECT_ID=saatraai
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
