# ─────────────────────────────────────────────────────────────
# SAATRAAI web — copy to .env.local and fill in.
# Never commit real secrets; never put backend/JWT/database
# secrets in any NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (FastAPI, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Google Sign-In (Google Identity Services) ───────────────
# Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID (Web application).
# Authorized JavaScript origins must include this app's origin,
# e.g. http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=460628897488-us7vi830e2erqa4gars1nurc9knu4puo.apps.googleusercontent.com

# Server-side audience check for the ID token. May mirror the
# public client id; kept separate so rotation can diverge.
GOOGLE_CLIENT_ID=460628897488-us7vi830e2erqa4gars1nurc9knu4puo.apps.googleusercontent.com


# Server-only secret used to derive the backend link credential
# for a verified Google identity (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
# NEVER expose this via NEXT_PUBLIC_* and NEVER reuse the backend
# JWT_SECRET_KEY here.
GOOGLE_BRIDGE_SECRET=generate-a-long-random-hex-string

# ── Firebase Web SDK ────────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app.
# These values are safe to expose in the browser. Never place a
# Firebase service-account JSON or private key in this file.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBKr64XkcBkYM_qMhXTBLNoje7YF9NuPmY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=saatraai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=saatraai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=saatraai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=460628897488
NEXT_PUBLIC_FIREBASE_APP_ID=1:460628897488:web:95b2fe85e62f08a036f8d5
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-GJZTXP8NJC

# ── GeoChat adapter ────────────────────────────────────────
# The backend exposes these authenticated routes after the model
# runtime and weights are configured in the root .env file:
#   POST /api/v1/models/geochat/vqa
#   POST /api/v1/models/geochat/grounding
# Model: MBZUAI/geochat-7B · adapter version: geochat-7B
